{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "autoupdate": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git *": "allow",
      "gh *": "allow",
      "brew *": "allow",
      "swift *": "allow",
      "xcrun *": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "read": "allow"
  }
}
